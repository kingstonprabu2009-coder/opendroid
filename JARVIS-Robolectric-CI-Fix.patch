diff --git a/app/build.gradle b/app/build.gradle
index 0000000..0000000 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -112,5 +112,12 @@ android {
             // a Log double.
             returnDefaultValues = true
+            // Robolectric fetches android-all jars itself (outside Gradle's
+            // dependency resolver). Use Maven Central's canonical endpoint
+            // instead of Robolectric's legacy repo1 hostname.
+            all {
+                systemProperty "robolectric.dependency.repo.url", "https://repo.maven.apache.org/maven2"
+                systemProperty "robolectric.dependency.repo.id", "central"
+            }
         }
     }
     sourceSets {
diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 0000000..0000000 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -16,5 +16,12 @@ jobs:
           distribution: temurin
           java-version: '21'
       - uses: gradle/actions/setup-gradle@v4
+      - name: Cache Robolectric Android SDK artifacts
+        uses: actions/cache@v4
+        with:
+          path: ~/.m2/repository/org/robolectric
+          key: robolectric-android-all-${{ runner.os }}-${{ hashFiles('app/build.gradle') }}
+          restore-keys: |
+            robolectric-android-all-${{ runner.os }}-
       - name: Make Gradle wrapper executable
         run: chmod +x ./gradlew
